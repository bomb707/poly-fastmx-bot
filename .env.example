# ============================================================================
#  FastMX simulation bot — configuration (copy to .env and edit)
#  Every value here is OPTIONAL: config.js has a working default for each.
#  Anything set in the real environment (pm2 env / shell) OVERRIDES the .env.
#  .env is gitignored (it holds the private key + wallet) — .env.example is not.
# ============================================================================

# ── TRACKED MARKET & WALLET ────────────────────────────────────────────────
# The wallet whose live fills the tracker mirrors (the bot's own funder). Also
# settable live from the dashboard (POST /api/set-market).
TRACK_WALLET=
ASSET=btc                        # btc | eth | sol | xrp
INTERVAL=5m                      # 5m | 15m
WINDOW_SEC=                      # blank = derived (5m=300, 15m=900)

# ── EXECUTION MODE ─────────────────────────────────────────────────────────
# simulation (SAFE default) = strategy runs on the live feed, fills SIMULATED,
#   NO real orders. live = the SAME decisions place REAL CLOB orders (REAL money).
EXECUTION_MODE=simulation        # simulation | live
LIVE_PRIVATE_KEY=                # REQUIRED for live. Signs CLOB orders. NEVER commit.
# PRIVATE_KEY=                    # alias for LIVE_PRIVATE_KEY
LIVE_FUNDER=                     # explicit funder (proxy) address; blank = derive from key (EOA)
LIVE_SIG_TYPE=EOA                # EOA | POLY_PROXY | POLY_GNOSIS_SAFE (proxy wallets = POLY_PROXY)
LIVE_MAX_ORDER_USD=25            # hard per-order USDC ceiling (typo/bug backstop); 0 = off
LIVE_TAKER_ORDER_TYPE=GTC        # boot/legacy fallback; dashboard "live order type" selects GTC (measured faster) or FAK for Helpme auto-orders
LIVE_GTC_CANCEL_REMAINDER_MS=0   # wait after GTC acknowledgement before canceling an unfilled remainder; 0 = immediate
LIVE_REST_TIMEOUT_S=10          # abandon a still-unfilled/partial entry or hedge after this long → cancel remainder + free the guard (0 = off)
MAX_SESSION_LOSS=0             # circuit breaker: auto-STOP the bot if session PnL drops to -this USDC (0=off)

# ── RUN MODE ───────────────────────────────────────────────────────────────
MODE=ui                          # ui (dashboard, Start/Stop) | console (headless, auto-start)
AUTO_START=0                     # 1 = start the engine at boot even in ui mode
SHADOW=1                         # 0 = disable the shadow A/B strategy sim
VERBOSE_LOG=false                # true = detailed order-routing logs (off = zero hot-path cost)

# ── DASHBOARD (HTTP + WS) ──────────────────────────────────────────────────
UI_PORT=4520                     # 0 = disable the dashboard
UI_SAMPLE_MS=120                 # how often a spot/book sample is pushed to the UI (ms)
DASHBOARD_MS=1000

# ── WEB AUTH (dashboard login) ─────────────────────────────────────────────
WEB_PASSWORD=                    # blank = built-in default password
AUTH_ALWAYS=                     # true/1 = always require login (even localhost)
SECURE_COOKIE=                   # true = mark the session cookie Secure (behind HTTPS)
TRUST_PROXY=                     # true = trust X-Forwarded-* (behind a reverse proxy)
WEB_SESSION_COOKIE=slipstream_session

# ── LIVE FEEDS (match the recorder) ────────────────────────────────────────
BINANCE_WS_URL=wss://stream.binance.com:9443
POLY_RTDS_WS_URL=wss://ws-live-data.polymarket.com
POLY_CLOB_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ── REST HOSTS ─────────────────────────────────────────────────────────────
GAMMA_HOST=https://gamma-api.polymarket.com
DATA_API_HOST=https://data-api.polymarket.com
BACKTEST_API=https://bapi-v2.polywinbot.com     # v2 tick source (/snapshot-ticks) — backtest ticks only (NO LONGER used for live resolution)
BAPI_V2_OB_BASE=https://bapi-v2-ob.polywinbot.com # v2 full-L2 frames (/orderbooks) used by recorded:false backview
BAPI_V3_BASE=https://bapi-v3.polywinbot.com   # v3 tick source domain (/markets/{slug}/snapshots) — has a default in config.js; override here
BAPI_KEY=                                        # required by v2 metadata + L2 backtests; keep this file local and never commit the real key
BACKTEST_MODE=v2                                 # v2 (default) | v3 | select — v2/v3 FIX the version + HIDE the config-menu picker; "select" shows the picker to choose live
BACKTEST_API_VERSION=v2                          # only used when BACKTEST_MODE=select (the starting version); fixed modes ignore it
LIVE_TICK_SYNC_MS=0                              # (auto-derived from the API version now: v2→200 · v3→0; not a user toggle) pre-derivation seed only

# ── LIVE WINDOW RESOLUTION (Polymarket official settlement) ────────────────
# Live windows now resolve via Polymarket's own crypto-price API (chainlink index, the real settlement
# source). A window stays "pending" until Polymarket reports completed, then winSide = close vs open.
POLY_CRYPTO_PRICE_BASE=https://polymarket.com/api/crypto/crypto-price
BTC_UP_WINS_ON_TIE=true                           # exact open==close tie → Up (house convention)
POLY_RESOLVE_429_BACKOFF_MS=60000                 # cool-off after a 429 rate-limit from the endpoint
POLY_RESOLVE_FIRST_DELAY_MS=12000                 # hold off settling a just-closed window this long so its ⏳ pending row is visible before it flips to the winner
ONCHAIN_RPC=https://polygon-bor-rpc.publicnode.com
CLOB_HOST=https://clob.polymarket.com
CLOB_CHAIN_ID=137
DK_BASE_URL=https://cred-v2.polywinbot.xyz      # credential/derive-key service

# ── ON-CHAIN CONTRACTS (Polygon) ───────────────────────────────────────────
CTF_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045   # ConditionalTokens
USDC_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB  # collateral
# PUSD_ADDRESS=                  # if set, takes precedence over USDC_ADDRESS
COLLATERAL_SYMBOL=pUSD

# ── DATABASE (MongoDB — fill/session store) ────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=poly_helpme

# ── TRACKER VIEW ───────────────────────────────────────────────────────────
SHOW_TRACKER=0                   # 0 (default) = hide+disable the whole tracker view (wallet selector, Track
                                 #   button, tracker charts, view-mode picker, "disable tracker" toggle) →
                                 #   shadow-only dashboard. 1 = show + enable the tracker.

# ── POLLING / TIMING ───────────────────────────────────────────────────────
ACTIVITY_POLL_MS=300
TRACKER_DISABLED=                # blank = follow SHOW_TRACKER (off when tracker hidden). 1 = force poll off
KEEP_CLOSED_WINDOWS=3
BOOK_BUFFER_MS=30000
BALANCE_CACHE_MS=4000
SESSION_FETCH_DELAY_MS=30

# ── STALENESS / RECONNECT ──────────────────────────────────────────────────
CHAINLINK_STALE_MS=90000
BINANCE_STALE_MS=30000
CLOB_STALE_MS=12000
TRADE_FRESH_MS=6000              # don't place a live order on a book older than this

# ── SHADOW STRATEGY ─────────────────────────────────────────────────────────
# SHADOW_PARAMS_JSON={"H_TARGET_DIRECTION_ON":true,"H_DIRECTION_LOOKBACK_MS":3000,"H_DIRECTION_CLOB_WEIGHT":0.5,"H_DIRECTION_BINANCE_WEIGHT":0.5,"H_CLOB_MID_VELOCITY_ON":true,"H_BINANCE_GAP_MOMENTUM_ON":true,"H_BINANCE_TREND_ON":false,"H_HEDGE_ON":true,"H_REVERSAL_ON":true,"H_MAX_ACTIONS_PER_WINDOW":7,"H_MAX_OPPOSITE_ACTIONS_PER_WINDOW":7}


# ── PATHS ──────────────────────────────────────────────────────────────────
# DATA_DIR=                       # blank = ./data/
# LOG_DIR=                        # blank = ./logs/
LOG_MAX_MB=3
