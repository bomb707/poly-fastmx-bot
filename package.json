{
  "name": "poly-fastmx-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FastMX — simulation-only BTC 5m CLOB/Binance velocity strategy with the poly-mom Binance trend regime. Dashboard on :4520.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test engine/*.test.mjs engine/strategies/*.test.mjs src/execution/*.test.mjs src/feeds/*.test.mjs src/lib/*.test.mjs src/server/*.test.mjs src/sources/*.test.mjs src/util/*.test.mjs",
    "test:resolution": "node --test src/execution/resolution.test.mjs",
    "test:rtds": "node --test src/feeds/rtdsChainlinkWs.test.mjs",
    "test:strategy": "node --test engine/strategies/helpme.test.mjs",
    "test:depth": "node src/feeds/marketDepthBook.test.mjs",
    "probe:execution": "node scripts/live-execution-probe.mjs",
    "backtest:gap-v4": "node research/gap-predictor-v4-orderbook.mjs",
    "research:maker:forward:test": "node --test research/passive-maker-forward-folds.test.mjs research/passive-maker-forward-audit-v17.test.mjs",
    "research:maker:v27:screen": "node research/run-passive-maker-v27-v28-screen.mjs v27 both",
    "research:maker:v27:evaluate": "node research/evaluate-v27-constant-size.mjs",
    "research:maker:v28:screen": "node research/run-passive-maker-v27-v28-screen.mjs v28 both",
    "research:maker:v28:evaluate": "node research/evaluate-v28-combined-risk.mjs",
    "research:maker:v29:screen": "node research/run-passive-maker-v29-value-cancel.mjs screen both",
    "research:maker:v29:evaluate": "node research/evaluate-v29-value-cancel.mjs screen",
    "research:maker:v30:screen": "MAKER_EXPERIMENT=v30-feed-intersection node research/run-passive-maker-v29-value-cancel.mjs screen both",
    "research:maker:v30:evaluate": "node research/evaluate-v29-value-cancel.mjs v30 screen",
    "research:maker:v31:screen": "MAKER_EXPERIMENT=v31-feed-geometric node research/run-passive-maker-v29-value-cancel.mjs screen both",
    "research:maker:v31:evaluate": "node research/evaluate-v29-value-cancel.mjs v31 screen",
    "research:maker:v31:full": "MAKER_EXPERIMENT=v31-feed-geometric node research/run-passive-maker-v29-value-cancel.mjs full both",
    "research:maker:v31:evaluate-full": "node research/evaluate-v29-value-cancel.mjs v31 full",
    "research:maker:v31:neighborhood": "MAKER_EXPERIMENT=v31-feed-geometric node research/run-passive-maker-v29-value-cancel.mjs neighborhood both",
    "research:maker:v31:evaluate-neighborhood": "node research/evaluate-v31-neighborhood.mjs",
    "research:maker:gap:test": "node --test research/passive-maker-gap-aggregation.test.mjs",
    "research:maker:v32:screen": "MAKER_EXPERIMENT=v32-power-ensemble node research/run-passive-maker-v29-value-cancel.mjs screen both",
    "research:maker:v32:evaluate": "node research/evaluate-v32-power-ensemble.mjs",
    "research:maker:v33:screen": "MAKER_EXPERIMENT=v33-market-implied node research/run-passive-maker-v29-value-cancel.mjs screen both",
    "research:maker:v33:evaluate": "node research/evaluate-v33-market-implied.mjs screen",
    "research:maker:v33:neighborhood": "MAKER_EXPERIMENT=v33-market-implied node research/run-passive-maker-v29-value-cancel.mjs neighborhood both",
    "research:maker:v33:evaluate-neighborhood": "node research/evaluate-v33-market-implied.mjs neighborhood",
    "research:maker:v33:full": "MAKER_EXPERIMENT=v33-market-implied node research/run-passive-maker-v29-value-cancel.mjs full both",
    "research:maker:v33:evaluate-full": "node research/evaluate-v33-market-implied.mjs full",
    "research:maker:credit:floor": "node research/run-maker-credit-floor.mjs maker130",
    "research:maker:audit-mirroring": "node research/audit-v4-complement-mirroring.mjs",
    "research:maker:130:baseline:validate": "node research/validate-passive-maker-maker130-baseline.mjs",
    "research:maker:v13:validate": "node research/validate-passive-maker-v13.mjs",
    "research:maker:v14:validate": "node research/validate-passive-maker-v14.mjs",
    "research:maker:v17:pdf": "node research/generate-v17-window-audit-pdf.mjs"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.6",
    "axios": "^1.18.1",
    "ethers": "^6.16.0",
    "mongodb": "^6.21.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "pdfkit": "^0.17.2"
  }
}
